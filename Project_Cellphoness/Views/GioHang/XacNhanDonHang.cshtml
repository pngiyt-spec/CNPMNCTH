@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:600px; margin: 50px auto; background:#fff; padding:40px; text-align:center; border-radius:10px; box-shadow:0 4px 15px rgba(0,0,0,0.1);">
    <i class="fa-solid fa-circle-check" style="font-size: 60px; color: #28a745; margin-bottom: 20px;"></i>
    <h2 style="color: #333;">ĐẶT HÀNG THÀNH CÔNG!</h2>
    <p style="color: #666; font-size: 16px; line-height: 1.6;">
        Cảm ơn quý khách đã tin tưởng và mua sắm tại CellphonesWeb.<br />
        Đơn hàng của quý khách đã được ghi nhận và đang chờ duyệt. Nhân viên của chúng tôi sẽ sớm liên hệ để xác nhận giao hàng.
    </p>
    <a href="/" style="display:inline-block; margin-top:20px; background:var(--red-cps); color:#fff; padding:12px 30px; border-radius:8px; text-decoration:none; font-weight:bold;">
        QUAY VỀ TRANG CHỦ
    </a>
</div>