@model IEnumerable<Project_Cellphoness.Models.TinTuc>

@{
    ViewBag.Title = "Tin tức Công nghệ 24h";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* TOÀN BỘ CSS CŨ GIỮ NGUYÊN (Không thay đổi) */
    .news-header {
        text-align: center;
        margin: 40px 0;
    }

        .news-header h1 {
            font-size: 32px;
            color: var(--text-dark);
            font-weight: 900;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .news-header p {
            color: #666;
            font-size: 15px;
        }

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin-bottom: 50px;
    }

    .news-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: 0.3s;
        cursor: pointer;
        position: relative;
        border: 1px solid #eee;
    }

        .news-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.1);
            border-color: #D70018;
        }

    .news-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        transition: 0.5s;
    }

    .news-card:hover .news-img {
        transform: scale(1.05);
    }

    .news-body {
        padding: 20px;
        position: relative;
        background: #fff;
    }

    .news-badge {
        position: absolute;
        top: -15px;
        left: 20px;
        background: #D70018;
        color: #fff;
        font-size: 12px;
        font-weight: bold;
        padding: 5px 12px;
        border-radius: 4px;
        text-transform: uppercase;
        box-shadow: 0 4px 6px rgba(215, 0, 24, 0.3);
    }

    .news-title {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        margin: 15px 0 10px 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-meta {
        display: flex;
        justify-content: space-between;
        color: #888;
        font-size: 13px;
        margin-top: 15px;
        border-top: 1px solid #f0f0f0;
        padding-top: 15px;
    }

    /* CSS CHO MODAL */
    .news-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: 0.3s;
    }

    .news-modal-content {
        background: #fff;
        width: 90%;
        max-width: 800px;
        border-radius: 15px;
        overflow: hidden;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        transform: translateY(50px);
        transition: 0.3s;
    }

    .news-modal-overlay.active {
        opacity: 1;
        display: flex;
    }

        .news-modal-overlay.active .news-modal-content {
            transform: translateY(0);
        }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 25px;
        border-bottom: 1px solid #eee;
        background: #fdfdfd;
    }

    .btn-close-modal {
        background: #f1f1f1;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
        transition: 0.2s;
    }

        .btn-close-modal:hover {
            background: #ff4d4f;
            color: white;
        }

    .modal-body {
        padding: 30px;
        overflow-y: auto;
        font-size: 16px;
        line-height: 1.8;
        color: #444;
    }

        .modal-body img {
            width: 100%;
            border-radius: 10px;
            margin-bottom: 20px;
            object-fit: contain;
        }

        .modal-body h2 {
            font-size: 24px;
            color: #333;
            margin-bottom: 15px;
            font-weight: bold;
        }

    .modal-date {
        color: #888;
        font-size: 14px;
        margin-bottom: 20px;
        display: block;
    }
</style>

<div class="news-header">
    <h1><i class="fa-regular fa-newspaper"></i> TIN TỨC CÔNG NGHỆ</h1>
    <p>Cập nhật những thông tin mới nhất về thị trường Smartphone, mẹo vặt và đánh giá sản phẩm.</p>
</div>

<div class="news-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var tin in Model)
        {
            <div class="news-card" onclick="openNewsModal(this)">
                <!-- Lấy hình ảnh từ CSDL -->
                <img src="@tin.HinhAnh" class="news-img" onerror="this.src='https://via.placeholder.com/800x400?text=News'" alt="@tin.TieuDe">
                <div class="news-body">
                    <div class="news-badge">TIN TỨC MỚI</div>
                    <!-- Tiêu đề từ CSDL -->
                    <h3 class="news-title">@tin.TieuDe</h3>
                    <div class="news-meta">
                        <span class="news-date">
                            <i class="fa-regular fa-calendar"></i>
                            <!-- Hiển thị ngày đăng, kiểm tra null để không bị lỗi -->
                            @(tin.NgayDang.HasValue ? tin.NgayDang.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")
                        </span>
                        <span><i class="fa-regular fa-newspaper"></i> AiraStore</span>
                    </div>
                </div>

                <!-- Nội dung ẩn để hiển thị lên Popup khi click -->
                <div class="news-full-content" style="display: none;">
                    <!-- Html.Raw giúp render chính xác nội dung HTML có xuống dòng, bôi đậm từ CSDL -->
                    @Html.Raw(tin.NoiDung)
                </div>
            </div>
        }
    }
    else
    {
        <div style="grid-column: span 3; text-align: center; padding: 50px; background: #fff; border-radius: 10px;">
            <i class="fa-regular fa-folder-open" style="font-size: 40px; color: #ccc; margin-bottom: 15px;"></i>
            <h3 style="color: #666;">Chưa có bài viết tin tức nào!</h3>
            <p style="color: #999;">Vui lòng thêm tin tức từ trang Quản trị Admin.</p>
        </div>
    }
</div>

<!-- CỬA SỔ ĐỌC BÁO NỔI (MODAL) -->
<div class="news-modal-overlay" id="newsModal">
    <div class="news-modal-content">
        <div class="modal-header">
            <span style="font-weight: bold; color: var(--red-cps);"><i class="fa-brands fa-hotjar"></i> TIN NÓNG TRONG NGÀY</span>
            <button class="btn-close-modal" onclick="closeNewsModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <h2 id="modalTitle">Tiêu đề</h2>
            <span class="modal-date" id="modalDate">Ngày đăng</span>
            <img id="modalImg" src="" alt="Ảnh" />
            <div id="modalContent">Nội dung</div>

            <div style="margin-top: 30px; text-align: center;">
                <button onclick="closeNewsModal()" class="brand-btn" style="background: #333; color: white;">Đóng bài viết</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openNewsModal(cardElement) {
        var title = cardElement.querySelector('.news-title').innerText;
        var date = cardElement.querySelector('.news-date').innerText;
        var imgSrc = cardElement.querySelector('.news-img').src;
        var content = cardElement.querySelector('.news-full-content').innerHTML;

        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalDate').innerHTML = date;
        document.getElementById('modalImg').src = imgSrc;
        document.getElementById('modalContent').innerHTML = content;

        var modal = document.getElementById('newsModal');
        modal.style.display = 'flex';
        setTimeout(function() { modal.classList.add('active'); }, 10);
    }

    function closeNewsModal() {
        var modal = document.getElementById('newsModal');
        modal.classList.remove('active');
        setTimeout(function() { modal.style.display = 'none'; }, 300);
    }

    window.onclick = function(event) {
        var modal = document.getElementById('newsModal');
        if (event.target == modal) { closeNewsModal(); }
    }
</script>