@{ ViewBag.Title = "Đặt lại mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div style="max-width: 500px; margin: 50px auto; background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center;">
    <h2 style="color: var(--red-cps); margin-bottom: 20px;"><i class="fa-solid fa-key"></i> TẠO MẬT KHẨU MỚI</h2>
    <p style="color: #555; margin-bottom: 20px;">Xác thực thành công! Mời bạn tạo mật khẩu mới cho tài khoản: <b>@Session["ResetEmail"]</b></p>

    @if (ViewBag.ThongBao != null)
    {<div style="color: red; margin-bottom: 15px; font-weight: bold;">@ViewBag.ThongBao</div>}

    @using (Html.BeginForm())
    {
        <input type="password" name="MatKhauMoi" required placeholder="Nhập mật khẩu mới..." style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px; margin-bottom: 15px; box-sizing: border-box;" />
        <input type="password" name="XacNhanMatKhau" required placeholder="Nhập lại mật khẩu mới..." style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px; margin-bottom: 15px; box-sizing: border-box;" />
        <button type="submit" style="width: 100%; background: var(--red-cps); color: white; padding: 12px; border: none; border-radius: 5px; font-weight: bold; font-size: 16px; cursor: pointer;">LƯU MẬT KHẨU VÀ ĐĂNG NHẬP</button>
    }
</div>