@{
    ViewBag.Title = "Bảng điều khiển - Thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div style="max-width: 1300px; margin: 20px auto; padding: 0 10px;">
    <h2 style="color: #333; margin-bottom: 25px;"><i class="fa-solid fa-chart-pie"></i> TỔNG QUAN HỆ THỐNG NĂM @ViewBag.NamHienTai</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">

        <div style="background: linear-gradient(135deg, #28a745, #20c997); color: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; opacity: 0.9;">TỔNG DOANH THU</h3>
            <h2 style="margin: 10px 0 0 0; font-size: 28px;">@String.Format("{0:0,0}", ViewBag.TongDoanhThu).Replace(",", ".") đ</h2>
            <i class="fa-solid fa-money-bill-wave" style="font-size: 40px; position: absolute; margin-top: -35px; margin-left: 170px; opacity: 0.3;"></i>
        </div>

        <div style="background: linear-gradient(135deg, #17a2b8, #117a8b); color: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; opacity: 0.9;">TỔNG ĐƠN HÀNG</h3>
            <h2 style="margin: 10px 0 0 0; font-size: 28px;">@ViewBag.TongDonHang đơn</h2>
            <i class="fa-solid fa-boxes-packing" style="font-size: 40px; position: absolute; margin-top: -35px; margin-left: 170px; opacity: 0.3;"></i>
        </div>

        <div style="background: linear-gradient(135deg, #ffc107, #e0a800); color: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; opacity: 0.9;">KHÁCH HÀNG</h3>
            <h2 style="margin: 10px 0 0 0; font-size: 28px;">@ViewBag.TongKhachHang người</h2>
            <i class="fa-solid fa-users" style="font-size: 40px; position: absolute; margin-top: -35px; margin-left: 170px; opacity: 0.3;"></i>
        </div>

        <div style="background: linear-gradient(135deg, #dc3545, #c82333); color: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; opacity: 0.9;">SẢN PHẨM TRONG KHO</h3>
            <h2 style="margin: 10px 0 0 0; font-size: 28px;">@ViewBag.TongSanPham máy</h2>
            <i class="fa-solid fa-mobile-screen" style="font-size: 40px; position: absolute; margin-top: -35px; margin-left: 170px; opacity: 0.3;"></i>
        </div>

    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">

        <div style="background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; color: #555; border-bottom: 2px solid #eee; padding-bottom: 10px;">Biểu Đồ Doanh Thu (@ViewBag.NamHienTai)</h3>
            <div style="height: 400px;">
                <canvas id="revenueChart" style="width: 100%; height: 100%;"></canvas>
            </div>
        </div>

        <div style="background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
            <h3 style="margin-top: 0; color: #555; border-bottom: 2px solid #eee; padding-bottom: 10px;">Top 5 Bán Chạy Nhất</h3>

            @if (ViewBag.TopSPLabels != null && ((List<string>)ViewBag.TopSPLabels).Count > 0)
            {
                <div style="height: 300px; display: flex; justify-content: center; align-items: center; margin-bottom: 20px;">
                    <canvas id="topProductsChart"></canvas>
                </div>
            }
            else
            {
                <div style="height: 300px; display: flex; justify-content: center; align-items: center; color: #999; font-style: italic;">
                    Chưa có đủ dữ liệu bán hàng để thống kê.
                </div>
            }
        </div>

    </div>
</div>

<script>
    // ==========================================================
    // 1. VẼ BIỂU ĐỒ CỘT - DOANH THU (UC33)
    // ==========================================================
    var labelsArray = @Html.Raw(Json.Encode(ViewBag.ChartLabels));
    var dataArray = @Html.Raw(Json.Encode(ViewBag.ChartData));

    var ctxRev = document.getElementById('revenueChart').getContext('2d');
    var revenueChart = new Chart(ctxRev, {
        type: 'bar',
        data: {
            labels: labelsArray,
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: dataArray,
                backgroundColor: 'rgba(215, 0, 24, 0.7)',
                borderColor: 'rgba(215, 0, 24, 1)',
                borderWidth: 2,
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // 2. VẼ BIỂU ĐỒ VÀNH KHUYÊN - TOP SẢN PHẨM (UC34)
    @if (ViewBag.TopSPLabels != null && ((List<string>)ViewBag.TopSPLabels).Count > 0)
    {
        <text>
        var topLabels = @Html.Raw(Json.Encode(ViewBag.TopSPLabels));
        var topData = @Html.Raw(Json.Encode(ViewBag.TopSPData));

        var ctxTop = document.getElementById('topProductsChart').getContext('2d');
        var topProductsChart = new Chart(ctxTop, {
            type: 'doughnut', 
            data: {
                labels: topLabels,
                datasets: [{
                    data: topData,
                    backgroundColor: [
                        'rgba(215, 0, 24, 0.8)',   
                        'rgba(40, 167, 69, 0.8)',  
                        'rgba(255, 193, 7, 0.8)',  
                        'rgba(23, 162, 184, 0.8)', 
                        'rgba(108, 117, 125, 0.8)' 
                    ],
                    borderColor: '#ffffff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom', 
                        labels: {
                            font: { size: 12 },
                            boxWidth: 15
                        }
                    }
                }
            }
        });
        </text>
    }
</script>