@model Project_Cellphoness.Models.DonHang

@{
    Layout = null; // Bắt buộc bằng null để trang trắng tinh, chỉ chứa khung hóa đơn khi in
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Hóa đơn điện tử #@Model.MaDH</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            background: #fff;
            margin: 0;
            padding: 20px;
        }

        .invoice-box {
            max-width: 850px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, .15);
            font-size: 14px;
            line-height: 24px;
            position: relative;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            border-bottom: 2px solid #D70018;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .company-info h2 {
            color: #D70018;
            margin: 0 0 5px 0;
            font-size: 26px;
            font-weight: 800;
        }

        .invoice-title {
            text-align: right;
        }

            .invoice-title h1 {
                margin: 0 0 5px 0;
                font-size: 24px;
                color: #333;
            }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-block h3 {
            margin-top: 0;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
            color: #555;
            font-size: 15px;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            margin-bottom: 30px;
        }

            .invoice-table th, .invoice-table td {
                padding: 12px;
                border-bottom: 1px solid #eee;
            }

            .invoice-table th {
                background-color: #f8f9fa;
                font-weight: bold;
                color: #333;
            }

        .text-right {
            text-align: right;
        }

        .signature-section {
            margin-top: 50px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            text-align: center;
        }

        /* CSS đặc biệt: Ẩn nút bấm khi in ra giấy/file PDF */
        @@media print {
            .no-print {
                display: none;
            }

            .invoice-box {
                border: none;
                box-shadow: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="no-print" style="max-width: 850px; margin: 0 auto 20px auto; display: flex; justify-content: space-between; background: #f8f9fa; padding: 10px 20px; border-radius: 5px; border: 1px solid #ddd;">
        <a href="javascript:void(0);" onclick="window.history.back();" style="color: #666; text-decoration: none; font-weight: bold;"><i class="fa-solid fa-arrow-left"></i> Quay lại trang đơn hàng</a>
        <button onclick="window.print();" style="background: #28a745; color: white; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer;"><i class="fa-solid fa-print"></i> TIẾN HÀNH IN / XUẤT PDF</button>
    </div>

    <div class="invoice-box">
        <div class="invoice-header">
            <div class="company-info">
                <h2>AIRASTORE SYSTEM</h2>
                <p><b>Địa chỉ:</b> Lãnh Binh Thăng, Quận 11, TP. Hồ Chí Minh</p>
                <p><b>Hotline:</b> 1900.6067 | <b>Email:</b> support@airastore.vn</p>
            </div>
            <div class="invoice-title">
                <h1>HÓA ĐƠN BÁN HÀNG</h1>
                <p><b>Mã đơn:</b> <span style="color: #D70018; font-weight: bold;">#@Model.MaDH</span></p>
                <p><b>Ngày lập:</b> @(Model.NgayDat.HasValue ? Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</p>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-block">
                <h3><i class="fa-solid fa-user"></i> Thông tin người nhận hàng</h3>
                <p><b>Khách hàng:</b> @Model.HoTenNhan</p>
                <p><b>Số điện thoại:</b> @Model.SDTNhan</p>
                <p><b>Địa chỉ giao hàng:</b> @Model.DiaChiNhan</p>
            </div>
            <div class="info-block">
                <h3><i class="fa-solid fa-credit-card"></i> Phương thức thanh toán</h3>
                <p><b>Hình thức:</b> @Model.PhuongThucTT</p>
                <p><b>Trạng thái đơn:</b> <span style="font-weight: bold;">@Model.TrangThaiDH</span></p>
                <p><b>Trạng thái TT:</b> @(Model.TrangThaiTT == true ? "Đã thanh toán" : "Chưa thanh toán (COD)")</p>
            </div>
        </div>

        <table class="invoice-table">
            <thead>
                <tr>
                    <th style="width: 5%; text-align: center;">STT</th>
                    <th style="width: 50%;">Tên điện thoại / Biến thể</th>
                    <th style="width: 15%; text-align: center;">Số lượng</th>
                    <th style="width: 15%; text-align: right;">Đơn giá</th>
                    <th style="width: 15%; text-align: right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in (List<Project_Cellphoness.Models.ChiTietDonHang>)ViewBag.ChiTiet)
                {
                    <tr>
                        <td style="text-align: center;">@stt</td>
                        <td style="font-weight: bold;">@item.SanPham.TenSP</td>
                        <td style="text-align: center;">@item.SoLuong</td>
                        <td style="text-align: right;">@String.Format("{0:0,0}", item.GiaMua).Replace(",", ".") đ</td>
                        <td style="text-align: right; font-weight: bold;">@String.Format("{0:0,0}", item.SoLuong * item.GiaMua).Replace(",", ".") đ</td>
                    </tr>
                    stt++;
                }

                <tr>
                    <td colspan="3" border="0"></td>
                    <td style="font-weight: bold; text-align: right; border-top: 2px solid #ddd;">TỔNG CỘNG:</td>
                    <td style="color: #D70018; font-weight: bold; text-align: right; font-size: 16px; border-top: 2px solid #ddd;">
                        @String.Format("{0:0,0}", Model.TongTien).Replace(",", ".") đ
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="font-style: italic; color: #666; margin-bottom: 30px;">
            * Giá trên đã bao gồm thuế GTGT (VAT) và các chi phí phụ trợ đi kèm sản phẩm.
        </div>

        <div class="signature-section">
            <div>
                <p><b>Người mua hàng</b></p>
                <p style="font-size: 12px; color: #888; margin-top: 0;">(Ký và ghi rõ họ tên)</p>
            </div>
            <div>
                <p><b>Người lập hóa đơn</b></p>
                <p style="font-size: 12px; color: #888; margin-top: 0;">(Ký, đóng dấu hệ thống)</p>
                <br /><br />
                <p style="font-weight: bold; color: #555;">Ban Quản Trị AiraStore</p>
            </div>
        </div>
    </div>

    <script>
        window.onload = function () {
            window.print();
        }
    </script>
</body>
</html>