@model IEnumerable<Project_Cellphoness.Models.DanhGia>

@{
    ViewBag.Title = "Kiểm duyệt Bình luận";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 1200px; margin: 20px auto; background: #fff; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
    <h2 style="color: #333; margin-bottom: 20px; border-bottom: 2px solid var(--red-cps, #D70018); padding-bottom: 10px;">
        <i class="fa-solid fa-comments"></i> KIỂM DUYỆT BÌNH LUẬN & ĐÁNH GIÁ
    </h2>

    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
        <thead>
            <tr style="background-color: #f8f9fa; text-align: left; border-bottom: 2px solid #dee2e6;">
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 15%;">Khách hàng</th>
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 20%;">Sản phẩm</th>
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 10%; text-align: center;">Đánh giá</th>
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 25%;">Nội dung bình luận</th>
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 10%; text-align: center;">Trạng thái</th>
                <th style="padding: 12px; font-weight: bold; color: #495057; width: 20%; text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #e9ecef; transition: background 0.2s;">
                        <td style="padding: 12px;">
                            <strong style="color: #007bff;">@(item.TaiKhoan != null ? item.TaiKhoan.HoTen : "Khách ẩn danh")</strong><br />
                            <small style="color: #999;"><i class="fa-regular fa-clock"></i> @(item.NgayDG.HasValue ? item.NgayDG.Value.ToString("dd/MM/yyyy HH:mm") : "")</small>
                        </td>
                        <td style="padding: 12px; font-weight: 500; color: #333;">
                            <a href="/Home/Details/@item.MaSP" target="_blank" style="text-decoration: none; color: #333;">
                                @(item.SanPham != null ? item.SanPham.TenSP : "Mã SP: " + item.MaSP)
                            </a>
                        </td>
                        <td style="padding: 12px; text-align: center; color: #f5b50a; font-size: 14px;">
                            @for (int i = 0; i < item.SoSao; i++)
                            {<span>★</span>}
                            <br /><span style="color: #666; font-size: 12px; font-weight: bold;">(@item.SoSao Sao)</span>
                        </td>
                        <td style="padding: 12px; color: #555; font-style: italic;">
                            "@item.NoiDung"
                        </td>
                        <td style="padding: 12px; text-align: center;">
                            @if (item.PheDuyet == true)
                            {
                                <span style="background: #e8f5e9; color: #2e7d32; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;"><i class="fa-solid fa-check"></i> Đã duyệt</span>
                            }
                            else if (item.PheDuyet == false)
                            {
                                <span style="background: #ffebee; color: #c62828; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;"><i class="fa-solid fa-eye-slash"></i> Đã ẩn</span>
                            }
                            else
                            {
                                <span style="background: #fff3cd; color: #856404; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;"><i class="fa-solid fa-hourglass-half"></i> Chờ duyệt</span>
                            }
                        </td>
                        <td style="padding: 12px; text-align: center;">
                            @if (item.PheDuyet != true)
                            {
                                <a href="@Url.Action("Duyet", "QuanLyDanhGia", new { id = item.MaDG })" style="background: #28a745; color: #fff; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: bold; margin-right: 3px;" title="Duyệt hiển thị">
                                    <i class="fa-solid fa-check"></i>
                                </a>
                            }

                            @if (item.PheDuyet != false)
                            {
                                <a href="@Url.Action("An", "QuanLyDanhGia", new { id = item.MaDG })" style="background: #ffc107; color: #333; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: bold; margin-right: 3px;" title="Ẩn bình luận">
                                    <i class="fa-solid fa-eye-slash"></i>
                                </a>
                            }

                            <a href="@Url.Action("Xoa", "QuanLyDanhGia", new { id = item.MaDG })" onclick="return confirm('Bạn có chắc chắn muốn XÓA VĨNH VIỄN bình luận này không?');" style="background: #dc3545; color: #fff; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: bold;" title="Xóa bỏ">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; padding: 40px; color: #999;">
                        <i class="fa-solid fa-check-double" style="font-size: 40px; margin-bottom: 15px; color: #28a745;"></i><br />
                        Chưa có bình luận nào!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>