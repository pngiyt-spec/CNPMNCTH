@model IEnumerable<Project_Cellphoness.Models.SanPham>

@{
    ViewBag.Title = "Cảnh báo tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 1000px; margin: 20px auto; background: #fff; padding: 25px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">

    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #dc3545; padding-bottom: 10px; margin-bottom: 20px;">
        <h2 style="color: #dc3545; margin: 0; font-weight: 800;">
            <i class="fa-solid fa-triangle-exclamation"></i> CẢNH BÁO TỒN KHO
            <span style="background: #dc3545; color: white; padding: 2px 10px; border-radius: 20px; font-size: 16px; vertical-align: middle; margin-left: 10px;">@ViewBag.SoLuongCanhBao máy</span>
        </h2>
        <a href="@Url.Action("Index", "SanPham")" style="color: #666; text-decoration: none;"><i class="fa-solid fa-arrow-left"></i> Quay lại kho tổng</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div style="background: #fff3cd; color: #856404; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #ffeeba;">
            <i class="fa-solid fa-bell"></i> <b>Chú ý:</b> Hệ thống phát hiện có <b>@ViewBag.SoLuongCanhBao</b> mẫu điện thoại đang ở mức tồn kho báo động (Từ 5 máy trở xuống). Vui lòng lên kế hoạch nhập thêm hàng sớm để không gián đoạn kinh doanh!
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #f8f9fa; text-align: left; border-bottom: 2px solid #dee2e6;">
                    <th style="padding: 12px; font-weight: bold; color: #495057;">Hình ảnh</th>
                    <th style="padding: 12px; font-weight: bold; color: #495057;">Tên Sản Phẩm</th>
                    <th style="padding: 12px; font-weight: bold; color: #495057;">Giá Bán</th>
                    <th style="padding: 12px; font-weight: bold; color: #dc3545; text-align: center;">Số Lượng Tồn</th>
                    <th style="padding: 12px; font-weight: bold; color: #495057; text-align: center;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sp in Model)
                {
                    <tr style="border-bottom: 1px solid #e9ecef; transition: background 0.2s;">
                        <td style="padding: 12px;">
                            <img src="@sp.HinhAnh" alt="@sp.TenSP" style="width: 50px; height: 50px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/50'" />
                        </td>
                        <td style="padding: 12px; font-weight: bold; color: #333;">@sp.TenSP</td>
                        <td style="padding: 12px; font-weight: bold;">@String.Format("{0:0,0}", sp.GiaBan).Replace(",", ".") đ</td>
                        <td style="padding: 12px; text-align: center;">
                            @if (sp.SoLuongTon == 0)
                            {
                                <span style="background: #dc3545; color: white; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 14px;">HẾT HÀNG (0)</span>
                            }
                            else
                            {
                                <span style="background: #ffc107; color: #333; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 14px;">Chỉ còn @sp.SoLuongTon</span>
                            }
                        </td>
                        <td style="padding: 12px; text-align: center;">
                            <a href="@Url.Action("Edit", "SanPham", new { id = sp.MaSP })" style="background: #28a745; color: #fff; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: bold; display: inline-block;">
                                <i class="fa-solid fa-plus"></i> Nhập thêm
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 50px 20px;">
            <i class="fa-solid fa-circle-check" style="font-size: 50px; color: #28a745; margin-bottom: 15px;"></i>
            <h3 style="color: #28a745; margin: 0 0 10px 0;">KHO HÀNG ĐANG RẤT ỔN ĐỊNH</h3>
            <p style="color: #666;">Hiện tại không có sản phẩm nào sắp hết hàng. Mọi mặt hàng đều có số lượng tồn kho trên mức an toàn.</p>
        </div>
    }
</div>