@model Project_Cellphoness.Models.SanPham

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border-top: 5px solid #dc3545; text-align: center;">
    <div style="color: #dc3545; font-size: 50px; margin-bottom: 15px;">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <h2 style="margin-top: 0; color: #333;">NGỪNG BÁN SẢN PHẨM?</h2>
    <p style="color: #666; margin-bottom: 25px;">Sản phẩm này sẽ được chuyển sang trạng thái <b>Ngừng kinh doanh</b> . Khách hàng sẽ không thể nhìn thấy sản phẩm này trên web nữa.</p>

    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; text-align: left; margin-bottom: 30px; border: 1px solid #eee;">
        <p style="margin: 5px 0;"><b>Mã sản phẩm:</b> SP-@Model.MaSP</p>
        <p style="margin: 5px 0;"><b>Tên điện thoại:</b> <span style="color: #dc3545; font-weight: bold;">@Model.TenSP</span></p>
        <p style="margin: 5px 0;"><b>Giá hiện tại:</b> @String.Format("{0:0,0}", Model.GiaBan).Replace(",", ".") đ</p>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div style="display: flex; gap: 15px;">
            <a href="@Url.Action("Index", "SanPham")" style="flex: 1; background: #6c757d; color: white; padding: 12px; border-radius: 5px; text-decoration: none; font-weight: bold; font-size: 15px; display: inline-block; box-sizing: border-box;">
                HỦY BỎ
            </a>
            <button type="submit" style="flex: 1; background: #dc3545; color: white; border: none; padding: 12px; border-radius: 5px; font-weight: bold; font-size: 15px; cursor: pointer;">
                <i class="fa-solid fa-trash-can"></i> ĐỒNG Ý 
            </button>
        </div>
    }
</div>